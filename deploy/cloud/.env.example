# Host directory that stores all CBI durable data. Keep this outside the Git checkout.
CBI_DATA_DIR=/srv/cbi-data

# Loopback-only port. Secure MCP Tunnel can target this directly.
CBI_LOOPBACK_PORT=8787

# Default is fail-closed bearer auth. Generate at least 32 random characters.
CBI_REMOTE_AUTH_MODE=bearer
CBI_REMOTE_BEARER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional Origin allow-list. Leave blank for server-to-server clients that send no Origin.
CBI_REMOTE_ALLOWED_ORIGINS=

# Public origin used in OAuth metadata and resource binding. On Render this is
# normally the service's https://<name>.onrender.com origin.
CBI_REMOTE_PUBLIC_BASE_URL=https://cbi.example.com

# Comma-separated GitHub logins allowed to authenticate through the ChatGPT
# OAuth proxy. Required for ChatGPT OAuth use; never put OAuth client secrets here.
CBI_REMOTE_GITHUB_ALLOWED_LOGINS=

# Only needed when using the optional public-https Caddy profile.
# Point this DNS name at the cloud host before starting Caddy.
CBI_MCP_DOMAIN=cbi.example.com
